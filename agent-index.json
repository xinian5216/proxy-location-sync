    "test": "npm test",
    "testRaw": "node --test tests/*.test.js",
    "build": "npm run build",
    "buildChromium": "npm run build:chromium",
    "buildFirefox": "npm run build:firefox",
    "package": "npm run package",
    "syntax": "find . -name '*.js' -o -name '*.mjs' | grep -v '/dist/' | grep -v '/node_modules/' | xargs -n1 node --check"
  },
  "ci": {
    "workflow": ".github/workflows/test.yml",
    "runs": "node --test tests/*.test.js"
  },
  "unverified": [
