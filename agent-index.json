      "manifest": ["manifests/base.json", "manifests/chromium.json"],
      "permissions": ["storage", "alarms", "offscreen", "scripting", "webNavigation"]
    },
    "firefox": {
      "background": "event_page",
      "poller": "alarm:pls-firefox-poll",
      "fallback": "none",
      "offscreen": false,
      "minimum": "128.0",
      "geckoId": "proxy-location-sync@xinian5216",
      "manifest": ["manifests/base.json", "manifests/firefox.json"],
      "permissions": ["storage", "alarms", "scripting", "webNavigation"]
    }
  },
