  "invariants": [
    "enabled=true must never fall back to real system GPS",
    "IP Echo is decoupled from Geo lookup",
    "slow Geo must not block the next IP Echo",
    "latest generation wins",
    "same-IP heartbeat writes zero storage",
    "a new exit must discard async results from the old exit",
    "manual diagnostics must not be aborted by same-IP auto",
    "a new IP may preempt diagnostics of the old IP",
    "Worker diagnostics must not use a Blob Worker on the target page",
    "Chromium uses Service Worker + Offscreen",
    "Firefox uses Event Page + alarms; no Offscreen; no Event Page setTimeout polling loop",
    "unsupported Firefox APIs are skipped after feature detection",
    "do not spoof language, UA, Canvas, WebGL, or fonts",
    "do not break stable Chromium behavior for Firefox compatibility"
  ],
  "stableModulesDoNotCasualEdit": [
    "content/injected.js",
    "lib/exit-pipeline.js",
    "lib/geolocation-gate.js",
    "lib/html-geo-element.js",
    "lib/timezone.js",
